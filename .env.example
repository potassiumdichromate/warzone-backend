PORT=3300
NODE_ENV=production
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/new-warzone?retryWrites=true&w=majority
MONGO_DB_NAME=new-warzone

# Kult Points proxy (server-to-server calls into kult-browser-backend-v2)
KULT_POINTS_API_BASE_URL=https://kult-browser-rust-l2lwg.ondigitalocean.app/api/internal/kult-points
KULT_POINTS_INTERNAL_HEADER_NAME=x-kult-internal-key
KULT_POINTS_INTERNAL_API_KEY=
# Optional separate key required by this service's add/subtract endpoints; defaults to KULT_POINTS_INTERNAL_API_KEY.
KULT_POINTS_PROXY_API_KEY=
MONGO_URI=mongodb://localhost:27017/new-warzone
MONGO_DB_NAME=new-warzone
PORT=3300

# Use the same strong random value as Highway Hustle's CONTEST_REWARD_GRANT_SECRET.
HIGHWAY_HUSTLE_REWARD_GRANT_SECRET=replace-with-shared-secret
HIGHWAY_HUSTLE_API_URL=https://highway-hustle-backend.onrender.com/api
HIGHWAY_HUSTLE_LAMBORGHINI_COIN_THRESHOLD=3000
HIGHWAY_HUSTLE_REWARD_TIMEOUT_MS=5000
